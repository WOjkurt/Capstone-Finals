{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Set via environment variable in production; use dotnet user-secrets locally"
  },
  "Firebase": {
    "ProjectId": "dbtc-cebu",
    "ServiceAccountKeyPath": "dbtc-firebase-service-account.json"
  },
  "Auth": {
    "AllowedEmailDomain": "@dbtc-cebu.edu.ph",
    "RequireVerifiedEmail": true
  },
  "Webhook": {
    "GoogleFormsSecret": "Set via environment variable in production; use dotnet user-secrets locally"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "WebhookPermitLimit": 60,
    "SearchPermitLimit": 30
  }
}
